# SGGE — variables de entorno
# Copie este archivo como `.env.local` y complete los valores.
# Nunca comitee `.env.local`: contiene credenciales reales.

# --- Supabase (obligatorias) -------------------------------------------------
# Panel de Supabase → Project Settings → API

# URL del proyecto. Se expone al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave anónima. Se expone al navegador; está sujeta a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SOLO servidor: ignora RLS y da acceso total a la base.
# Jamás debe llevar el prefijo NEXT_PUBLIC_ ni usarse en un Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcionales --------------------------------------------------------------

# UUID del usuario de sistema con el que se firman los eventos automáticos del
# historial. Si no se define, se usa un identificador por defecto.
SRRG_SYSTEM_USER_ID=

# --- Solo para scripts de mantenimiento y respaldo ---------------------------
# Cadena de conexión directa a Postgres, usada por `npm run db:backup` y por el
# workflow de respaldo (allí se lee del secreto SUPABASE_DB_URL de GitHub).
# Panel de Supabase → Project Settings → Database → Connection string
SUPABASE_DB_URL=
