## Metadata dinámica

```typescript
export async function generateMetadata({ params }: { params: { id: string } }) {
  const entity = await getEntityById(params.id)
  return {
    title: entity?.name ?? 'Not Found',
    description: entity?.description,
  }
}
```

## Error Boundaries por módulo

```typescript
// modules/[module]/error.tsx
'use client'

export default function ModuleError({
  error,
  reset,
}: {
  error: Error & { digest?: string }
  reset: () => void
}) {
  return (
    <div>
      <h2>Error en el módulo</h2>
      <button onClick={reset}>Reintentar</button>
    </div>
  )
}
```

## Estructura de módulo — ejemplo

```
modules/invoices/
├── index.ts
├── components/
│   ├── InvoiceList.tsx       # Server Component
│   ├── InvoiceForm.tsx       # Client Component
├── hooks/useInvoiceFilters.ts
├── actions/create-invoice.ts # "use server"
├── queries/get-invoices.ts
└── types/invoice.types.ts
```
