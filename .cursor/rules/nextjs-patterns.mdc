# Next.js App Router — Patrones

## Server Components por defecto

```typescript
// app/(dashboard)/[module]/page.tsx — Sin "use client"
import { getUserEntities } from '@/modules/[module]/queries'
import { EntityList } from '@/modules/[module]/components'
import { createClient } from '@/lib/supabase/server'
import { redirect } from 'next/navigation'

export default async function ModulePage() {
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) redirect('/login')

  const entities = await getUserEntities(user.id)
  return <EntityList entities={entities} />
}
```

