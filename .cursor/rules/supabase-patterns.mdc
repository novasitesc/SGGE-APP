supabase gen types typescript --project-id [PROJECT_ID] > src/lib/db/types.ts
```

## Queries tipadas

```typescript
// modules/[module]/queries/[entity].queries.ts
import { createClient } from '@/lib/supabase/server'
import type { Database } from '@/lib/db/types'

type Entity = Database['public']['Tables']['[table]']['Row']

export async function getEntityById(id: string): Promise<Entity | null> {
  const supabase = await createClient()
  const { data, error } = await supabase
    .from('[table]')
    .select('*')
    .eq('id', id)
    .single()

  if (error) {
    console.error('[Module] getEntityById error:', error)
    return null
  }
  return data
}
```

## Server Actions

```typescript
'use server'

import { revalidatePath } from 'next/cache'
import { redirect } from 'next/navigation'
import { createClient } from '@/lib/supabase/server'
import { z } from 'zod'

const CreateEntitySchema = z.object({
  name: z.string().min(1).max(255),
  description: z.string().optional(),
})

export async function createEntity(formData: FormData) {
  const supabase = await createClient()
  const { data: { user }, error: authError } = await supabase.auth.getUser()
  if (authError || !user) redirect('/login')

  const parsed = CreateEntitySchema.safeParse({
    name: formData.get('name'),
    description: formData.get('description'),
  })
  if (!parsed.success) {
    return { error: parsed.error.flatten().fieldErrors }
  }

  const { error } = await supabase
    .from('[table]')
    .insert({ ...parsed.data, user_id: user.id })

  if (error) return { error: { _form: [error.message] } }

  revalidatePath('/[module-route]')
  return { success: true }
}
```

## Auth Proxy (Next.js 16)

`middleware.ts` está **deprecado**. Usar `proxy.ts` + `lib/supabase/proxy.ts`.

- Usar `getClaims()` (o `getUser()`) en servidor/proxy; **nunca** `getSession()` para autorizar
- Refrescar sesión en `updateSession` y reconocer secciones SGGE: auth, app, admin, api
- Proteger rutas de app/admin en el Proxy; las API deciden auth en el handler
- Activar redirecciones con `AUTH_PROXY_ENFORCE=true` cuando el login esté cableado
- Nunca exponer `SUPABASE_SERVICE_ROLE_KEY` en el cliente
- Siempre validar inputs con Zod antes de operaciones DB
- Siempre verificar `auth.uid()` en RLS
